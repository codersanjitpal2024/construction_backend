# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB connection string (use your Atlas URI or local replica-set URI)
MONGODB_URI=mongodb://127.0.0.1:27017/construction_db?replicaSet=rs0

# Frontend origin used by CORS
CLIENT_URL=http://localhost:5173

# Use a long, random secret in each environment
JWT_SECRET=replace-with-a-long-random-secret

# Initial administrator used by `npm run seed:admin`
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
